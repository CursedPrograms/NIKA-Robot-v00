<?xml version="1.0" encoding="UTF-8"?>
<!--
  Colour scheme for NIKA, sampled from images/nika_avatar.jpg.
  Avatar palette: purple eyes, synth screen and LED necklace on an autumn girl (leaf orange,
  a circuit-green badge), purple-black in the shadows. The purple is the one the fleet knows
  her by (her site, NORA's fleet-link panel).
  Used by her controller's themes (scripts/controller_kit.py) and any UI that loads it.

  Format: one colour per line, written exactly as  name="..." value="#RRGGBB".
-->
<colour_scheme>
  <!-- Surfaces -->
  <colour name="background"       value="#0B0812"/>  <!-- window / page background -->
  <colour name="panel"            value="#140E21"/>  <!-- cards, panels, idle buttons -->
  <colour name="border"           value="#2C2143"/>  <!-- panel edges, button outlines -->
  <colour name="divider"          value="#1D1530"/>  <!-- lines between rows -->

  <!-- Text -->
  <colour name="text"             value="#F1ECF2"/>  <!-- primary text -->
  <colour name="text_sec"         value="#A99DB0"/>  <!-- secondary text -->
  <colour name="text_dim"         value="#6E6276"/>  <!-- labels, section titles -->

  <!-- Accents -->
  <colour name="accent"           value="#963CFF"/>  <!-- her purple: logo, links, selected / hover -->
  <colour name="accent_hover"     value="#B377FF"/>  <!-- lighter accent: values, connected dot -->
  <colour name="accent2"          value="#E07A3C"/>  <!-- second avatar colour: the autumn leaves -->
  <colour name="accent3"          value="#3FB874"/>  <!-- third avatar colour: the circuit badge -->

  <!-- Buttons -->
  <colour name="button_hover_bg"  value="#1F1033"/>  <!-- button fill when hovered / selected -->
  <colour name="danger_bg"        value="#210F0D"/>  <!-- STOP button fill -->
</colour_scheme>
