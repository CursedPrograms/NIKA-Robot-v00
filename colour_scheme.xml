<?xml version="1.0" encoding="UTF-8"?>
<!--
  Colour scheme for NIKA, sampled from images/nika_avatar.jpg.
  Avatar palette: an autumn girl in a rust jacket among orange leaves, purple LEDs and synth screen,
  a circuit-green badge, plum-black in the shadows. Orange leads; the purple stays as her second colour.
  Used by her controller's themes (scripts/controller_kit.py), her site and NORA's fleet-link panel.

  Format: one colour per line, written exactly as  name="..." value="#RRGGBB".
-->
<colour_scheme>
  <colour name="background" value="#110C14"/>
  <colour name="panel" value="#1C1420"/>
  <colour name="border" value="#3A2A36"/>
  <colour name="divider" value="#281C2A"/>
  <colour name="text" value="#F3ECE2"/>
  <colour name="text_sec" value="#B8A99E"/>
  <colour name="text_dim" value="#7A6B68"/>
  <colour name="accent" value="#D9703A"/>
  <colour name="accent_hover" value="#EC9160"/>
  <colour name="accent2" value="#963CFF"/>
  <colour name="accent3" value="#3FB874"/>
  <colour name="button_hover_bg" value="#2A1810"/>
  <colour name="danger_bg" value="#2A0F0D"/>
</colour_scheme>
